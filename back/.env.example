# ============================================
# PronosticsPro – Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ===== SERVER =====
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://votre-site.vercel.app

# ===== DATABASE =====
# MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/pronosticspro
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/pronosticspro

# ===== AUTH =====
# Générez une clé secrète forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_CETTE_CLE_SECRETE_EN_PRODUCTION

# ===== SPORTS API =====
# API-Sports (https://api-sports.io) – Plan gratuit: 100 req/jour
SPORTS_API_KEY=VOTRE_CLE_API_SPORTS

# All Sports API backup (https://allsportsapi.com)
ALL_SPORTS_API_KEY=VOTRE_CLE_ALL_SPORTS

# ===== AI (OpenAI) =====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-VOTRE_CLE_OPENAI

# ===== OPTIONAL: PAYMENTS =====
# CinetPay (Mobile Money Cameroun)
CINETPAY_API_KEY=VOTRE_CLE_CINETPAY
CINETPAY_SITE_ID=VOTRE_SITE_ID
